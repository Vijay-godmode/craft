# Set this to a long random value before exposing the application publicly.
RESUME_SECRET_KEY=replace-with-a-long-random-secret
# Optional: store the SQLite database outside the application directory.
# RESUME_DB_PATH=/absolute/path/to/careercraft.db
# Optional port for `python app.py`.
# PORT=8000
# Optional official Google Programmable Search credentials for employer-board
# results. Enable the Custom Search JSON API in Google Cloud first. Keep both
# values server-side; do not put them in browser code.
# GOOGLE_CUSTOM_SEARCH_API_KEY=
# GOOGLE_CUSTOM_SEARCH_CX=
